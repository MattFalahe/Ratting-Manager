{
  "name": "mattfalahe/ratting-manager",
  "description": "Ratting management plugin for SeAT - Track bounty ticks and ESS payouts for every member, with personal and corporation dashboards, leaderboards and ISK per hour",
  "type": "seat-plugin",
  "keywords": [
    "seat",
    "eve",
    "eveonline",
    "ratting",
    "bounty",
    "ess",
    "corporation",
    "management",
    "plugin"
  ],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Matt Falahe",
      "email": "mattfalahe@gmail.com"
    }
  ],
  "homepage": "https://github.com/MattFalahe/Ratting-Manager",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0",
    "eveseat/web": "^5.0",
    "eveseat/services": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "RattingManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RattingManager\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "RattingManager\\RattingManagerServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "tests/vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
